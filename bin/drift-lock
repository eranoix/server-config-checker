#!/bin/sh

set -u

here=$(cd "$(dirname "$0")/.." && pwd) || exit 2
uid=$(id -u)
lockdir=${DRIFT_LOCK_DIR:-${TMPDIR:-/tmp}/drift-locks-$uid}
names=${DRIFT_LOCKS_FILE:-$here/locks.conf}
poll=${DRIFT_LOCK_POLL:-0.2}
grace=${DRIFT_LOCK_GRACE:-5}
timeout=300

say() { printf 'drift-lock: %s\n' "$*" >&2; }
usage() { say "usage: drift-lock [-t SECONDS] NAME -- COMMAND [ARG...]"; exit 2; }

while getopts t: opt; do
  case $opt in
    t) timeout=$OPTARG ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -ge 3 ] || usage
name=$1
[ "$2" = "--" ] || usage
shift 2

case $timeout in '' | *[!0-9]*) say "timeout must be whole seconds"; exit 2 ;; esac
case $name in '' | *[!a-z0-9-]*) say "invalid lock name: $name"; exit 2 ;; esac
[ -f "$names" ] || { say "lock list not found: $names"; exit 2; }
if ! grep -v '^[[:space:]]*#' "$names" | awk '{print $1}' | grep -qx -- "$name"; then
  say "unknown lock name '$name' (known: $(grep -v '^[[:space:]]*#' "$names" | awk 'NF{print $1}' | tr '\n' ' '))"
  exit 2
fi

mkdir -p "$lockdir" || exit 2
L="$lockdir/$name.lock"
G="$lockdir/$name.steal"
me=$(hostname 2>/dev/null || uname -n)

alive() {
  [ -n "$1" ] || return 1
  kill -0 "$1" 2>/dev/null && return 0
  [ -d "/proc/$1" ]
}

snapshot() { owner=$(cat "$L/owner" 2>/dev/null); }
field() { printf '%s\n' "$owner" | sed -n "s/^$1=//p"; }
# shellcheck disable=SC2012
ino() { ls -di "$1" 2>/dev/null | awk '{print $1}'; }

is_stale() {
  reason=
  snapshot
  if [ -z "$owner" ]; then
    _ino=$(ino "$L")
    [ -n "$_ino" ] || { noowner_ino=; return 1; }
    if [ "$_ino" != "$noowner_ino" ]; then
      noowner_ino=$_ino
      noowner_since=$(date +%s)
      return 1
    fi
    [ $(($(date +%s) - noowner_since)) -ge "$grace" ] || return 1
    reason="no owner file for ${grace}s"
    return 0
  fi
  noowner_ino=
  _host=$(field host)
  _pid=$(field pid)
  _child=$(field child)
  [ -n "$_host" ] && [ -n "$_pid" ] || return 1
  if [ "$_host" != "$me" ]; then
    [ "$warned" = 1 ] || say "lock $name is held from host $_host, waiting (cannot check its process from here)"
    warned=1
    return 1
  fi
  alive "$_pid" && return 1
  alive "$_child" && return 1
  reason="holder pid $_pid (command pid ${_child:-none}) is gone"
}

try_guard() {
  if mkdir "$G" 2>/dev/null; then
    guard_ino=
    return 0
  fi
  _gi=$(ino "$G")
  [ -n "$_gi" ] || { guard_ino=; return 1; }
  if [ "$_gi" != "$guard_ino" ]; then
    guard_ino=$_gi
    guard_since=$(date +%s)
    return 1
  fi
  if [ $(($(date +%s) - guard_since)) -ge "$grace" ]; then
    say "removing guard $G left for ${grace}s by a process that died recovering"
    rmdir "$G" 2>/dev/null
    guard_ino=
  fi
  return 1
}

steal_if_stale() {
  try_guard || return 1
  if is_stale; then
    if [ -n "$owner" ]; then rm -f "$L/owner"; fi
    rm -f "$L/owner.tmp"
    if rmdir "$L" 2>/dev/null; then
      say "recovered stale lock $name: $reason"
    fi
    noowner_ino=
  fi
  rmdir "$G" 2>/dev/null
  return 0
}

token=
release() {
  [ -n "$token" ] || return 0
  guard_ino=
  until try_guard; do sleep "$poll"; done
  snapshot
  if [ "$(field token)" = "$token" ]; then
    rm -f "$L/owner"
    rmdir "$L" 2>/dev/null
  fi
  rmdir "$G" 2>/dev/null
  token=
}

write_owner() {
  {
    echo "name=$name"
    echo "host=$me"
    echo "pid=$$"
    echo "child=$1"
    echo "since=$since"
    echo "token=$token"
    echo "command=$cmdline"
  } >"$L/owner.tmp" && mv "$L/owner.tmp" "$L/owner"
}

start=$(date +%s)
noowner_since=0
noowner_ino=
guard_since=0
guard_ino=
warned=0
while ! mkdir "$L" 2>/dev/null; do
  steal_if_stale
  if [ $(($(date +%s) - start)) -ge "$timeout" ]; then
    say "timeout after ${timeout}s waiting for lock $name; command NOT run"
    snapshot
    if [ -n "$owner" ]; then
      say "held by: $(field host) pid $(field pid) since $(field since): $(field command)"
    fi
    exit 2
  fi
  sleep "$poll"
done
since=$(date +%s)
token="$me:$$:$since"
cmdline=$*
write_owner "" || { say "could not record the owner of lock $name; command NOT run"; rmdir "$L" 2>/dev/null; exit 2; }

child=
# shellcheck disable=SC2317,SC2329 # invoked by the trap below (SC2317 is the same warning in shellcheck 0.9)
on_signal() {
  [ -n "$child" ] && kill "$child" 2>/dev/null
  release
  exit 2
}
trap release EXIT
trap on_signal INT TERM HUP

exec 3<&0
"$@" <&3 3<&- &
child=$!
write_owner "$child"
wait "$child"
rc=$?
child=
release
exit "$rc"
